{"name":"ebook - KOReader","description":"Supported extensions: azw, azw3, cbz, cbr, djvu, doc, docx, epub, epub3, fb2, html, mobi, opds, pdf, rtf, and txt.","acceptedFilenameRegex":"^(.*)\\.(?:azw|azw3|cbz|cbr|djvu|doc|docx|epub|epub3|fb2|html|mobi|opds|pdf|rtf|txt)$","platform":"Book Reader","packageName":"org.koreader.launcher","activityName":"org.koreader.launcher.MainActivity","action":"android.intent.action.VIEW","flagJsonStr":"[]","paramJsonStr":"{}","dataFilePathType":"{file.uri}","dataType":"{file.mime}","isKillApp":"true","launcherParams":"-n org.koreader.launcher/.MainActivity\n -c android.intent.category.DEFAULT\n -a android.intent.action.VIEW\n -t {file.mime}\n -d {file.uri}"}
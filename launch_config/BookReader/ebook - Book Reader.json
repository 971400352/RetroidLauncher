{"name":"ebook - Book Reader","description":"Supported extensions: azw, azw3, cbz, cbr, djvu, doc, docx, epub, epub3, fb2, html, mobi, opds, pdf, rtf, and txt.","acceptedFilenameRegex":"^(.*)\\.(?:azw|azw3|cbz|cbr|djvu|doc|docx|epub|epub3|fb2|html|mobi|opds|pdf|rtf|txt)$","platform":"Book Reader","packageName":"com.github.axet.bookreader","activityName":"com.github.axet.bookreader.activities.MainActivity","action":"android.intent.action.VIEW","flagJsonStr":"[]","paramJsonStr":"{}","dataFilePathType":"{file.uri}","dataType":"{file.mime}","isKillApp":"true","launcherParams":"-n com.github.axet.bookreader/.activities.MainActivity\n -c android.intent.category.DEFAULT\n -a android.intent.action.VIEW\n -t {file.mime}\n -d {file.uri}"}